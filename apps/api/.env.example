# Localhost by default; the Docker integration sets HOST inside its container.
HOST=127.0.0.1
PORT=3001
FRONTEND_URL=http://localhost:3000
# npm run setup:env at repository root creates matching local credentials.
DATABASE_URL=postgresql://automation_monitor:replace-with-a-local-password@127.0.0.1:5433/automation_monitor?schema=public

# Production requires HTTPS; Secure cookies are enabled when NODE_ENV=production.

# Local background alert worker
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
