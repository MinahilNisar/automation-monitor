generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum EventType {
  STARTED
  COMPLETED
  FAILED
}

model Workflow {
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String   @id @default(uuid()) @db.Uuid
  slug        String
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  runs        Run[]

  @@unique([workspaceId, slug])
}

model Run {
  id          String    @id @default(uuid()) @db.Uuid
  workflowId  String    @db.Uuid
  externalId  String
  status      RunStatus
  startedAt   DateTime  @db.Timestamptz(3)
  finishedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  events      RunEvent[]

  @@unique([workflowId, externalId])
  @@index([workflowId, startedAt])
  @@index([status, startedAt])
}

model RunEvent {
  id          String    @id @default(uuid()) @db.Uuid
  runId       String    @db.Uuid
  externalId  String
  type        EventType
  message     String
  occurredAt  DateTime  @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  run         Run       @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, externalId])
  @@index([runId, occurredAt])
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  memberships Membership[]
  sessions Session[]
}

model Workspace {
  id String @id @default(uuid()) @db.Uuid
  name String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  memberships Membership[]
  workflows Workflow[]
}

model Membership {
  userId String @db.Uuid
  workspaceId String @db.Uuid
  role WorkspaceRole @default(MEMBER)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@id([userId, workspaceId])
  @@index([workspaceId])
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  userId String @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
