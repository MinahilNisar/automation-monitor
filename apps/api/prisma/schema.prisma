generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum EventType {
  STARTED
  COMPLETED
  FAILED
}

model Workflow {
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  id          String   @id @default(uuid()) @db.Uuid
  slug        String
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  rerunRequests RerunRequest[]
  alertPolicy AlertPolicy?
  alerts Alert[]
  keys        WorkflowApiKey[]
  runs        Run[]

  @@unique([workspaceId, slug])
}

model Run {
  id          String    @id @default(uuid()) @db.Uuid
  workflowId  String    @db.Uuid
  externalId  String
  status      RunStatus
  startedAt   DateTime? @db.Timestamptz(3)
  finishedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  events      RunEvent[]
  replayInput Json?
  rerunRequestId String? @db.Uuid

  @@unique([workflowId, externalId])
  @@index([workflowId, startedAt])
  @@index([workflowId, createdAt, id])
  @@index([status, startedAt])
}

model RunEvent {
  id          String    @id @default(uuid()) @db.Uuid
  runId       String    @db.Uuid
  externalId  String
  type        EventType
  replayInput Json?
  rerunRequestId String? @db.Uuid
  message     String
  occurredAt  DateTime  @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  run         Run       @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, externalId])
  @@index([runId, occurredAt])
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  memberships Membership[]
  sessions Session[]
  issuedKeys WorkflowApiKey[]
  requestedReruns RerunRequest[]
}

model Workspace {
  id String @id @default(uuid()) @db.Uuid
  name String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  memberships Membership[]
  workflows Workflow[]
  revision WorkspaceRevision?
}

model Membership {
  userId String @db.Uuid
  workspaceId String @db.Uuid
  role WorkspaceRole @default(MEMBER)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@id([userId, workspaceId])
  @@index([workspaceId])
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  userId String @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model WorkflowApiKey {
  id String @id @default(uuid()) @db.Uuid
  workflowId String @db.Uuid
  createdById String? @db.Uuid
  label String
  keyHash String @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  @@index([workflowId, createdAt])
}

enum AlertKind {
  FAILURE
  MISSING_RUN
}
enum AlertDelivery {
  PENDING
  DELIVERED
  FAILED
}
model AlertPolicy {
  workflowId String @id @db.Uuid
  failureEnabled Boolean @default(false)
  expectedMinutes Int?
  monitoringSince DateTime @default(now()) @db.Timestamptz(3)
  generation String @default(uuid()) @db.Uuid
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}
model Alert {
  id String @id @default(uuid()) @db.Uuid
  workflowId String @db.Uuid
  runId String? @db.Uuid
  kind AlertKind
  dedupeKey String @unique
  message String
  delivery AlertDelivery @default(PENDING)
  attempts Int @default(0)
  lastError String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  readAt DateTime? @db.Timestamptz(3)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  @@index([workflowId, createdAt, id])
  @@index([delivery, id])
}

model WorkspaceRevision {
  workspaceId String @id @db.Uuid
  revision BigInt @default(0)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
enum RerunStatus {
  REQUESTED
  OBSERVED
  REJECTED
  UNCERTAIN
}
model RerunRequest {
  id String @id @db.Uuid
  workflowId String @db.Uuid
  sourceRunId String @unique @db.Uuid
  resultRunId String? @db.Uuid
  requestedById String? @db.Uuid
  requestedByName String
  status RerunStatus @default(REQUESTED)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  requestedBy User? @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  @@index([workflowId, createdAt])
}
