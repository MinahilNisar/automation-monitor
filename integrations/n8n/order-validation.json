{
  "id": "amordersMain",
  "name": "Automation Monitor · validate orders",
  "active": false,
  "nodes": [
    {
      "id": "ac32a121-929d-42e7-92e8-03d1321bb468",
      "name": "Order webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "automation-monitor/orders",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "9e244beb-2d80-47f5-82fe-def0150d822b",
      "credentials": {
        "httpHeaderAuth": {
          "id": "amordersWebhookKey",
          "name": "Orders webhook · local"
        }
      }
    },
    {
      "id": "93e5c950-c468-4950-9b9f-8e69a1399e65",
      "name": "Capture start",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { runId: 'n8n:' + $execution.id, eventId: 'started', type: 'STARTED', occurredAt: $now.toUTC().toISO(), message: 'Order validation started.', ...(typeof $('Order webhook').first().json.body.orderId === 'string' && $('Order webhook').first().json.body.orderId.length > 0 && $('Order webhook').first().json.body.orderId.length <= 80 && typeof $('Order webhook').first().json.body.amount === 'number' && Number.isFinite($('Order webhook').first().json.body.amount) && Math.abs($('Order webhook').first().json.body.amount) <= 1000000 ? { replayInput: { orderId: $('Order webhook').first().json.body.orderId, amount: $('Order webhook').first().json.body.amount }, ...($('Order webhook').first().json.body.rerunRequestId ? { rerunRequestId: $('Order webhook').first().json.body.rerunRequestId } : {}) } : {}) } }}",
        "options": {}
      }
    },
    {
      "id": "e58a54bb-db4b-4b9f-ad69-add8e7250e15",
      "name": "Report started",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://monitor-api:3001/ingest/workflows/00000000-0000-4000-8000-000000000000/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "amordersMonitorKey",
          "name": "Automation Monitor · orders"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "05679d54-ec71-41fe-a8e2-43346a389521",
      "name": "Valid order?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "1e82f975-bef2-47f9-9e9e-945b525df752",
              "leftValue": "={{ typeof $('Order webhook').first().json.body.orderId === 'string' && $('Order webhook').first().json.body.orderId.length > 0 && $('Order webhook').first().json.body.orderId.length <= 80 && typeof $('Order webhook').first().json.body.amount === 'number' && Number.isFinite($('Order webhook').first().json.body.amount) && $('Order webhook').first().json.body.amount > 0 && $('Order webhook').first().json.body.amount <= 1000000 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "279e3376-010f-4337-86e0-aa581c8074ac",
      "name": "Build receipt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        -120
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { orderId: $('Order webhook').first().json.body.orderId, subtotal: $('Order webhook').first().json.body.amount, tax: Math.round($('Order webhook').first().json.body.amount * 0.1 * 100) / 100, total: Math.round($('Order webhook').first().json.body.amount * 1.1 * 100) / 100 } }}",
        "options": {}
      }
    },
    {
      "id": "5279ab5f-0318-4a79-92fe-10018a867ff5",
      "name": "Capture completion",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1200,
        -120
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { runId: $('Capture start').first().json.runId, eventId: 'completed', type: 'COMPLETED', occurredAt: $now.toUTC().toISO(), message: 'Order validated and receipt calculated. No payment was taken.' } }}",
        "options": {}
      }
    },
    {
      "id": "95954faa-033e-42ba-b9d0-927329df96e8",
      "name": "Report completed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1440,
        -120
      ],
      "parameters": {
        "method": "POST",
        "url": "http://monitor-api:3001/ingest/workflows/00000000-0000-4000-8000-000000000000/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "amordersMonitorKey",
          "name": "Automation Monitor · orders"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "c0fa61bd-2983-4c4a-93a1-c590dde10f1f",
      "name": "Return receipt",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1680,
        -120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { accepted: true, executionId: $('Capture start').first().json.runId, receipt: $('Build receipt').first().json } }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "8377a975-df18-461c-980b-15c788d16733",
      "name": "Reject invalid order",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        960,
        160
      ],
      "parameters": {
        "errorMessage": "Order must have an orderId and a positive numeric amount no greater than 1000000."
      }
    }
  ],
